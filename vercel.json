{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"llms-txt\"; type=\"text/plain\", </llms.md>; rel=\"alternate\"; type=\"text/markdown\"; title=\"Full profile in Markdown\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
        },
        { "key": "X-Llms-Txt", "value": "/llms.txt" },
        { "key": "X-Llms-Md", "value": "/llms.md" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/llms.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
